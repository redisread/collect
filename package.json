{
  "name": "collect",
  "version": "0.1.0",
  "private": true,
  "description": "Collect RSS Reader - A modern RSS reader built with Hono, Astro, and Flutter",
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "turbo dev --filter=api",
    "dev:frontend": "turbo dev --filter=frontend",
    "build": "turbo build",
    "build:api": "turbo build --filter=api",
    "build:frontend": "turbo build --filter=frontend",
    "deploy:api": "turbo deploy --filter=api",
    "deploy:frontend": "turbo deploy --filter=frontend",
    "deploy": "turbo deploy",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean && rm -rf node_modules",
    "generate": "./scripts/generate-code.sh",
    "generate:openapi": "pnpm --filter @collect/shared generate:openapi"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.7.4"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.0.0"
}
