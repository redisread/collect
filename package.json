{
  "name": "collect",
  "version": "0.1.0",
  "private": true,
  "description": "Collect RSS Reader - A modern RSS reader built with Hono, Astro, and SwiftUI",
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "turbo dev --filter=api",
    "dev:frontend": "turbo dev --filter=frontend",
    "build": "turbo build",
    "build:api": "turbo build --filter=api",
    "build:frontend": "turbo build --filter=frontend",
    "deploy": "pnpm --filter frontend deploy",
    "deploy:dry-run": "pnpm --filter frontend deploy:dry-run",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean && rm -rf node_modules",
    "generate": "./scripts/generate-code.sh",
    "generate:openapi": "pnpm --filter @collect/shared generate:openapi"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.7.4"
  },
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11.24"
  },
  "packageManager": "pnpm@11.24.0"
}
