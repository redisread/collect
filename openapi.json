{
  "openapi": "3.0.0",
  "info": {
    "version": "1.0.0",
    "title": "Collect API",
    "description": "A modern RSS reader API"
  },
  "servers": [
    {
      "url": "/api",
      "description": "API base path"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Authentication operations"
    },
    {
      "name": "Folders",
      "description": "Folder management"
    },
    {
      "name": "Feeds",
      "description": "RSS feed management"
    },
    {
      "name": "Articles",
      "description": "Article management"
    },
    {
      "name": "OPML",
      "description": "OPML import/export"
    }
  ],
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "user_123"
          },
          "name": {
            "type": "string",
            "example": "John Doe"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "john@example.com"
          },
          "emailVerified": {
            "type": "boolean",
            "example": true
          },
          "image": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ]
          },
          "updatedAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "emailVerified",
          "createdAt",
          "updatedAt"
        ]
      },
      "Folder": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "folder_123"
          },
          "userId": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "Tech News"
          },
          "color": {
            "type": "string",
            "nullable": true,
            "example": "#6366f1"
          },
          "icon": {
            "type": "string",
            "nullable": true,
            "example": "folder"
          },
          "sortOrder": {
            "type": "number",
            "example": 0
          },
          "isCollapsed": {
            "type": "boolean",
            "example": false
          },
          "createdAt": {
            "type": "string",
            "nullable": true
          },
          "updatedAt": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "userId",
          "name"
        ]
      },
      "CreateFolderInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "Tech News"
          },
          "color": {
            "type": "string",
            "example": "#6366f1"
          },
          "icon": {
            "type": "string",
            "example": "folder"
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateFolderInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "color": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "sortOrder": {
            "type": "number"
          },
          "isCollapsed": {
            "type": "boolean"
          }
        }
      },
      "Feed": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "feed_123"
          },
          "userId": {
            "type": "string"
          },
          "folderId": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "example": "TechCrunch"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "example": "https://techcrunch.com"
          },
          "feedUrl": {
            "type": "string",
            "format": "uri",
            "example": "https://techcrunch.com/feed/"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "faviconUrl": {
            "type": "string",
            "nullable": true
          },
          "lastFetchedAt": {
            "type": "string",
            "nullable": true
          },
          "sortOrder": {
            "type": "number"
          },
          "createdAt": {
            "type": "string",
            "nullable": true
          },
          "updatedAt": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "userId",
          "title",
          "url",
          "feedUrl"
        ]
      },
      "CreateFeedInput": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "example": "https://example.com/rss.xml"
          },
          "folderId": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ]
      },
      "UpdateFeedInput": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "folderId": {
            "type": "string"
          },
          "sortOrder": {
            "type": "number"
          }
        }
      },
      "Article": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "article_123"
          },
          "feedId": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "example": "Breaking News"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "content": {
            "type": "string",
            "nullable": true
          },
          "summary": {
            "type": "string",
            "nullable": true
          },
          "author": {
            "type": "string",
            "nullable": true
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          },
          "publishedAt": {
            "type": "string",
            "nullable": true
          },
          "isRead": {
            "type": "boolean",
            "example": false
          },
          "isStarred": {
            "type": "boolean",
            "example": false
          },
          "isReadLater": {
            "type": "boolean",
            "example": false
          },
          "createdAt": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "feedId",
          "title",
          "url"
        ]
      },
      "UpdateArticleInput": {
        "type": "object",
        "properties": {
          "isRead": {
            "type": "boolean"
          },
          "isStarred": {
            "type": "boolean"
          },
          "isReadLater": {
            "type": "boolean"
          }
        }
      },
      "OPMLFeed": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "xmlUrl": {
            "type": "string"
          },
          "htmlUrl": {
            "type": "string"
          },
          "folder": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "xmlUrl"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/folders": {
      "get": {
        "tags": [
          "Folders"
        ],
        "summary": "List folders",
        "responses": {
          "200": {
            "description": "List of folders",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Folder"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Folders"
        ],
        "summary": "Create folder",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFolderInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created folder",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Folder"
                }
              }
            }
          }
        }
      }
    },
    "/feeds": {
      "get": {
        "tags": [
          "Feeds"
        ],
        "summary": "List feeds",
        "responses": {
          "200": {
            "description": "List of feeds",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Feed"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Feeds"
        ],
        "summary": "Create feed",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFeedInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created feed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Feed"
                }
              }
            }
          }
        }
      }
    },
    "/articles": {
      "get": {
        "tags": [
          "Articles"
        ],
        "summary": "List articles",
        "parameters": [
          {
            "name": "feedId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "isRead",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "isStarred",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of articles",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Article"
                }
              }
            }
          }
        }
      }
    },
    "/articles/{id}": {
      "put": {
        "tags": [
          "Articles"
        ],
        "summary": "Update article",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateArticleInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated article",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Article"
                }
              }
            }
          }
        }
      }
    },
    "/opml": {
      "get": {
        "tags": [
          "OPML"
        ],
        "summary": "Export OPML",
        "responses": {
          "200": {
            "description": "OPML file",
            "content": {
              "text/xml": {}
            }
          }
        }
      },
      "post": {
        "tags": [
          "OPML"
        ],
        "summary": "Import OPML",
        "requestBody": {
          "content": {
            "text/xml": {}
          }
        },
        "responses": {
          "200": {
            "description": "Import result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "feedsImported": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/refresh": {
      "post": {
        "tags": [
          "Feeds"
        ],
        "summary": "Refresh RSS feeds",
        "responses": {
          "200": {
            "description": "Refresh result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "feedsProcessed": {
                      "type": "number"
                    },
                    "articlesAdded": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}