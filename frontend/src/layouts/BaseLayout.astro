---
import "../styles/global.css";
import { PwaUpdateNotice } from "../components/app/PwaControls";

interface Props {
  title?: string;
}

const { title = "Collect" } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/collect.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="theme-color" content="#F3CD54" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Collect" />
    <!-- 防止主题切换闪烁 -->
    <script is:inline>
      (function() {
        try {
          var stored = localStorage.getItem('folio-ui');
          var theme = stored ? JSON.parse(stored).state?.theme : 'system';
          var isDark = theme === 'dark' || (theme !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
          if (isDark) document.documentElement.classList.add('dark');
        } catch(e) {}
      })();
    </script>
  </head>
  <body>
    <slot />
    <PwaUpdateNotice client:load />
  </body>
</html>
