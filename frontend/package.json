{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --port 4321",
    "build": "astro build && node scripts/build-pwa.mjs",
    "preview": "astro preview",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:dry-run": "pnpm build && wrangler deploy --dry-run",
    "cf-typegen": "wrangler types --config wrangler.jsonc ./worker-configuration.d.ts",
    "cf-typecheck": "wrangler types --check --config wrangler.jsonc ./worker-configuration.d.ts",
    "check:startup": "wrangler check startup --config dist/server/wrangler.json",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "type-check": "astro check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.5",
    "@astrojs/react": "^6.0.4",
    "astro": "^7.2.9",
    "better-auth": "^1.7.2",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "hono": "4.13.5",
    "isomorphic-dompurify": "^3.23.0",
    "jotai": "^2.19.0",
    "react": "^19.1.5",
    "react-dom": "^19.1.5",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@cloudflare/workers-types": "5.20260829.1",
    "@tailwindcss/vite": "^4.1.3",
    "@types/node": "22",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "30",
    "tailwindcss": "^4.1.3",
    "typescript": "^5.9.3",
    "vitest": "4.1.11",
    "wrangler": "^4.127.1"
  }
}
