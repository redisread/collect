{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter frontend dev",
    "build": "tsc --noEmit",
    "cf-typegen": "pnpm --filter frontend cf-typegen",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply collect-db --config ../frontend/wrangler.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply collect-db --local --config ../frontend/wrangler.jsonc",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:runtime": "node scripts/test-opml-runtime.mjs"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@mozilla/readability": "^0.6.0",
    "better-auth": "^1.7.2",
    "cheerio": "^1.0.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "linkedom": "^0.18.12",
    "resend": "^6.10.0",
    "rss-parser": "^3.13.0",
    "sax": "^1.6.1",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260829.1",
    "@types/node": "^20",
    "@types/sax": "^1.2.7",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.9",
    "typescript": "^5.7.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
