{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./src/cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply collect-db",
    "db:migrate:local": "wrangler d1 migrations apply collect-db --local",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.3",
    "@mozilla/readability": "^0.6.0",
    "better-auth": "^1.5.4",
    "cheerio": "^1.0.0",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.7.7",
    "linkedom": "^0.18.12",
    "resend": "^6.10.0",
    "rss-parser": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250321.0",
    "@types/node": "^20",
    "@vitest/coverage-v8": "^3.0.0",
    "drizzle-kit": "^0.31.9",
    "miniflare": "^3.0.0",
    "typescript": "^5.7.4",
    "vitest": "^3.0.0",
    "vitest-environment-miniflare": "^2.14.4",
    "wrangler": "^4.81.1"
  }
}
